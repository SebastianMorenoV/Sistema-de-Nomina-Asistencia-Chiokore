# Copia este archivo a .env solo si quieres cambiar algo; sin .env se usan estos mismos valores.

# Base de datos (los usuarios se crean la primera vez; si los cambias después, borra el volumen
# con "docker compose down -v", lo que también borra los datos)
MYSQL_ROOT_PASSWORD=chiokore-root
MYSQL_USER=chiokore
MYSQL_PASSWORD=chiokore

# Puertos en la máquina (el POS usa 3307, 8082 y 5175, y espera esta API en el 8080)
FRONTEND_PORT=3000
BACKEND_PORT=8080
DB_PORT=3308

# Zona horaria del negocio: define el día y la hora de las asistencias
ZONA_HORARIA=America/Hermosillo

# true habilita "Simular Huella" (solo para probar sin lector; el botón aparece con npm run dev)
APP_HUELLA_SIMULACION=false

# Orígenes que pueden llamar a la API desde el navegador (separados por coma, acepta comodines).
# El frontend de Docker no lo necesita porque usa el proxy /api de nginx.
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

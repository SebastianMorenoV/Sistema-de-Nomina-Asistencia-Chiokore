# Copia este archivo como application.properties (ese sí está en .gitignore) y pon tu contraseña de MySQL.
server.port=8080

spring.datasource.url=jdbc:mysql://localhost:3306/nomina_asistencia?createDatabaseIfNotExist=true&allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC
spring.datasource.username=root
spring.datasource.password=TU_PASSWORD_AQUI
spring.jpa.hibernate.ddl-auto=update

# Llaves de los JWT: se generan la primera vez en estas rutas (los .pem están en .gitignore).
# Sin estas líneas se genera un par nuevo en cada arranque y los tokens anteriores dejan de servir.
jwt.rsa.private-key-path=keys/private_key.pem
jwt.rsa.public-key-path=keys/public_key.pem

# Permite el modo "Simular Huella" (solo para desarrollo, sin lector físico)
app.huella.simulacion=false

# Orígenes que pueden llamar a la API desde el navegador (separados por coma, acepta comodines)
app.cors.allowed-origins=http://localhost:5173
